<%- include('../layout/header') %><div class="mb-3"><a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Kembali</a></div><h3 class="text-navy fw-bold mb-4">Lapor Barang Temuan</h3><div class="card"><div class="card-body"><% if(error){%><div class="alert alert-danger"><%=error%></div><%}%><form method="post" action="/lapor/temuan" enctype="multipart/form-data"><div class="row g-3"><div class="col-md-6"><label class="form-label">Nama Barang *</label><input name="nama_barang" class="form-control" required></div><div class="col-md-6"><label class="form-label">Kategori *</label><select name="id_kategori" class="form-select" required><option value="">Pilih kategori</option><%kategori.forEach(k=>{%><option value="<%=k.id_kategori%>"><%=k.nama_kategori%></option><%})%></select></div><div class="col-md-6"><label class="form-label">Lokasi Ditemukan *</label><input name="lokasi_ditemukan" class="form-control" required></div><div class="col-md-6"><label class="form-label">Tanggal Ditemukan *</label><input type="date" name="tanggal_ditemukan" class="form-control" required></div><div class="col-md-6"><label class="form-label">Lokasi Pos Penyimpanan *</label><input name="lokasi_pos_penyimpanan" class="form-control" required></div><div class="col-md-6"><label class="form-label">Foto Barang * (JPG/PNG, maksimal 5MB)</label><input type="file" name="foto_barang" accept=".jpg,.jpeg,.png" class="form-control" required></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea name="deskripsi_umum" class="form-control" rows="4"></textarea></div></div><button class="btn btn-navy mt-4">Kirim Laporan Temuan</button></form></div></div><%- include('../layout/footer') %>