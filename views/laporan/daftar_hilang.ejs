<%- include('../layout/header') %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm mb-2"><i class="bi bi-arrow-left"></i> Kembali</a>
    <h3 class="text-navy fw-bold mb-0"><%= isStaff ? 'Daftar Seluruh Laporan Kehilangan Kampus' : 'Daftar Laporan Kehilangan Saya' %></h3>
  </div>
  <a href="/lapor/hilang" class="btn btn-navy"><i class="bi bi-plus-circle"></i> Buat Laporan Baru</a>
</div>
<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <% if (isStaff) { %><th>Pelapor</th><% } %>
          <th>Nama Barang</th>
          <th>Kategori</th>
          <th>Tanggal Kejadian</th>
          <th>Lokasi Terakhir</th>
          <th>Deskripsi</th>
          <th>Status</th>
          <th>Tanggal Dibuat</th>
        </tr>
      </thead>
      <tbody>
        <% if (laporan.length) { %>
          <% laporan.forEach(l => { %>
            <tr>
              <% if (isStaff) { %>
                <td>
                  <strong><%= l.nama_lengkap %></strong><br>
                  <small class="text-muted"><%= l.email_kampus %> | <%= l.nomor_telepon || '-' %></small>
                </td>
              <% } %>
              <td><strong><%= l.nama_barang %></strong></td>
              <td><%= l.nama_kategori %></td>
              <td><%= new Date(l.tanggal_kejadian).toLocaleDateString('id-ID') %></td>
              <td><%= l.lokasi_terakhir %></td>
              <td><%= l.deskripsi || '-' %></td>
              <td>
                <span class="badge <%= l.status_laporan === 'aktif' ? 'bg-warning text-dark' : 'bg-success' %>">
                  <%= l.status_laporan %>
                </span>
              </td>
              <td><%= new Date(l.created_at).toLocaleDateString('id-ID') %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="<%= isStaff ? 8 : 7 %>" class="text-center text-muted py-4">Belum ada laporan kehilangan.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../layout/footer') %>
