<%- include('../layout/header') %>
<div class="mb-3"><a href="/katalog" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Kembali</a></div>
<div class="row g-4"><div class="col-md-7"><img src="/uploads/<%= item.foto_barang %>" class="catalog-detail-img shadow-sm" alt="<%= item.nama_barang %>" onerror="this.src='https://placehold.co/900x500/1a237e/ffffff?text=Foto+Barang'"></div><div class="col-md-5"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start mb-3"><h3 class="fw-bold text-navy mb-0"><%= item.nama_barang %></h3><% if(item.status_barang==='Tersedia'){%><span class="badge badge-tersedia">Tersedia</span><%}else if(item.status_barang==='Sedang Proses Klaim'){%><span class="badge badge-proses">Proses Klaim</span><%}else{%><span class="badge badge-dikembalikan">Dikembalikan</span><%}%></div><dl class="row"><dt class="col-sm-5 text-muted">Kategori</dt><dd class="col-sm-7"><%= item.nama_kategori %></dd><dt class="col-sm-5 text-muted">Lokasi Ditemukan</dt><dd class="col-sm-7"><%= item.lokasi_ditemukan %></dd><dt class="col-sm-5 text-muted">Tanggal</dt><dd class="col-sm-7"><%= new Date(item.tanggal_ditemukan).toLocaleDateString('id-ID') %></dd><dt class="col-sm-5 text-muted">Lokasi Penyimpanan</dt><dd class="col-sm-7"><%= item.lokasi_pos_penyimpanan %></dd></dl><hr><h6 class="fw-bold">Deskripsi</h6><p class="text-muted"><%= item.deskripsi_umum || 'Tidak ada deskripsi.' %></p><% if(['satpam','administrator'].includes(user.peran_pengguna)){%><div class="alert alert-warning small"><strong>Kontak Pelapor:</strong><br><%= item.nama_lengkap %><br><%= item.email_kampus %><br><%= item.nomor_telepon || 'Nomor telepon tidak tersedia' %></div><%}%><% if(user.peran_pengguna==='mahasiswa' && item.status_barang==='Tersedia'){%><a href="/klaim/<%= item.id_barang_temuan %>" class="btn btn-navy w-100"><i class="bi bi-hand-index"></i> Ajukan Klaim Kepemilikan</a><%}%></div></div></div></div>
<%- include('../layout/footer') %>
