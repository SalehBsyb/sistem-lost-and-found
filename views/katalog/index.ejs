<%- include('../layout/header') %>
<div class="d-flex justify-content-between align-items-center mb-4"><div><h3 class="fw-bold text-navy mb-1">Katalog Barang Temuan</h3><p class="text-muted mb-0">Temukan barang yang mungkin milik Anda</p></div><span class="badge bg-navy fs-6"><%= items.length %> barang</span></div>
<div class="card mb-4"><div class="card-body"><form method="get" action="/katalog"><div class="row g-2"><div class="col-md-4"><label class="form-label small">Cari barang / lokasi</label><input name="q" value="<%= f.q %>" class="form-control" placeholder="Contoh: dompet, perpustakaan"></div><div class="col-md-2"><label class="form-label small">Kategori</label><select name="id_kategori" class="form-select"><option value="">Semua</option><% kategori.forEach(k=>{ %><option value="<%= k.id_kategori %>" <%= String(f.id_kategori)===String(k.id_kategori)?'selected':'' %>><%= k.nama_kategori %></option><% }) %></select></div><div class="col-md-2"><label class="form-label small">Status</label><select name="status" class="form-select"><option value="">Semua</option><option <%= f.status==='Tersedia'?'selected':'' %>>Tersedia</option><option <%= f.status==='Sedang Proses Klaim'?'selected':'' %>>Sedang Proses Klaim</option><option <%= f.status==='Dikembalikan'?'selected':'' %>>Dikembalikan</option></select></div><div class="col-md-2"><label class="form-label small">Dari tanggal</label><input type="date" name="dari" value="<%= f.dari %>" class="form-control"></div><div class="col-md-2"><label class="form-label small">Sampai tanggal</label><input type="date" name="sampai" value="<%= f.sampai %>" class="form-control"></div><div class="col-12 d-flex justify-content-end"><a href="/katalog" class="btn btn-sm btn-outline-secondary me-2">Reset</a><button class="btn btn-sm btn-navy"><i class="bi bi-search"></i> Cari</button></div></div></form></div></div>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4"><% if(items.length){items.forEach(item=>{ %><div class="col"><div class="card h-100 card-hover"><img src="/uploads/<%= item.foto_barang %>" class="card-img-top catalog-img" alt="<%= item.nama_barang %>" onerror="this.src='https://placehold.co/400x250/1a237e/ffffff?text=Foto+Barang'"><div class="card-body d-flex flex-column"><div class="d-flex justify-content-between mb-2"><span class="badge bg-secondary"><%= item.nama_kategori %></span><% if(item.status_barang==='Tersedia'){%><span class="badge badge-tersedia">Tersedia</span><%}else if(item.status_barang==='Sedang Proses Klaim'){%><span class="badge badge-proses">Proses Klaim</span><%}else{%><span class="badge badge-dikembalikan">Dikembalikan</span><%}%></div><h5 class="card-title text-navy"><%= item.nama_barang %></h5><p class="small text-muted mb-1"><i class="bi bi-geo-alt"></i> <%= item.lokasi_ditemukan %></p><p class="small text-muted"><i class="bi bi-calendar"></i> <%= new Date(item.tanggal_ditemukan).toLocaleDateString('id-ID') %></p><a href="/katalog/<%= item.id_barang_temuan %>" class="btn btn-outline-navy mt-auto">Lihat Detail</a></div></div></div><%})}else{%><div class="col-12"><div class="alert alert-info text-center">Barang tidak ditemukan dengan filter tersebut.</div></div><%}%></div>
<%- include('../layout/footer') %>
