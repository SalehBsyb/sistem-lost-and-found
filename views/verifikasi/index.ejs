<%- include('../layout/header') %><h3 class="fw-bold text-navy mb-4">Verifikasi Klaim Kepemilikan</h3><div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Barang</th><th>Pengklaim</th><th>Waktu Pengajuan</th><th>Ciri Rahasia</th><th>Aksi</th></tr></thead><tbody><%if(items.length){items.forEach(c=>{%><tr><td><strong><%=c.nama_barang%></strong></td><td><%=c.nama_lengkap%><br><small class="text-muted"><%=c.email_kampus%></small></td><td><%=new Date(c.waktu_pengajuan).toLocaleString('id-ID')%></td><td><button class="btn btn-sm btn-outline-navy" data-bs-toggle="modal" data-bs-target="#detail<%=c.id_klaim%>">Lihat Detail</button><div class="modal fade" id="detail<%=c.id_klaim%>" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Ciri Rahasia - <%=c.nama_barang%></h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><%=c.ciri_rahasia%></div></div></div></div></td><td><div class="d-flex gap-1"><form method="post" action="/verifikasi/<%=c.id_klaim%>/setuju" onsubmit="return confirm('Setujui klaim ini?')"><button class="btn btn-sm btn-success">Setujui</button></form><button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#tolak<%=c.id_klaim%>">Tolak</button></div><div class="modal fade" id="tolak<%=c.id_klaim%>" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/verifikasi/<%=c.id_klaim%>/tolak"><div class="modal-header"><h5 class="modal-title">Tolak Klaim</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Alasan penolakan *</label><textarea name="alasan_penolakan" class="form-control" rows="3" required minlength="5"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button><button class="btn btn-danger">Tolak Klaim</button></div></form></div></div></div></td></tr><%})}else{%><tr><td colspan="5" class="text-center text-muted py-5">Tidak ada klaim yang menunggu verifikasi.</td></tr><%}%></tbody></table></div></div><%- include('../layout/footer') %>