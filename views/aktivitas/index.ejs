<%- include('../layout/header') %><h3 class="fw-bold text-navy mb-4">Aktivitas Saya</h3><div class="card mb-4"><div class="card-header">Laporan Kehilangan</div><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Barang</th><th>Kategori</th><th>Tanggal Kejadian</th><th>Lokasi Terakhir</th><th>Status</th><th>Dilaporkan</th></tr></thead><tbody><%if(laporan.length){laporan.forEach(a=>{%><tr><td><%=a.nama_barang%></td><td><%=a.nama_kategori%></td><td><%=new Date(a.tanggal_kejadian).toLocaleDateString('id-ID')%></td><td><%=a.lokasi_terakhir%></td><td><span class="badge <%=a.status_laporan==='aktif'?'bg-warning text-dark':'bg-success'%>"><%=a.status_laporan%></span></td><td><%=new Date(a.created_at).toLocaleDateString('id-ID')%></td></tr><%})}else{%><tr><td colspan="6" class="text-center text-muted py-3">Belum ada laporan kehilangan.</td></tr><%}%></tbody></table></div></div><div class="card"><div class="card-header"><%= typeof isStaff !== 'undefined' && isStaff ? 'Riwayat Klaim Diverifikasi' : 'Riwayat Klaim' %></div><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Barang</th><th>Waktu Pengajuan</th><th>Status</th><th>Alasan Penolakan</th></tr></thead><tbody><%if(klaim.length){klaim.forEach(c=>{%><tr><td><%=c.nama_barang%></td><td><%=new Date(c.waktu_pengajuan).toLocaleString('id-ID')%></td><td><span class="badge <%=c.status_klaim==='Disetujui'?'bg-success':c.status_klaim==='Ditolak'?'bg-danger':'bg-warning text-dark'%>"><%=c.status_klaim%></span></td><td><%=c.alasan_penolakan||'-'%></td></tr><%})}else{%><tr><td colspan="4" class="text-center text-muted py-3">Belum ada riwayat klaim.</td></tr><%}%></tbody></table></div></div><%- include('../layout/footer') %>