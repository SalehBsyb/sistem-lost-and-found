<%- include('../layout/header') %><div class="d-flex justify-content-between align-items-center mb-4"><h3 class="fw-bold text-navy">Rekap Laporan Barang Temuan</h3><button class="btn btn-navy no-print" onclick="window.print()"><i class="bi bi-printer"></i> Cetak</button></div><div class="card mb-3 no-print"><div class="card-body"><form method="get" class="row g-2"><div class="col-md-3"><label class="form-label small">Dari tanggal</label><input type="date" name="dari" value="<%=f.dari%>" class="form-control"></div><div class="col-md-3"><label class="form-label small">Sampai tanggal</label><input type="date" name="sampai" value="<%=f.sampai%>" class="form-control"></div><div class="col-md-3"><label class="form-label small">Kategori</label><select name="id_kategori" class="form-select"><option value="">Semua</option><%kategori.forEach(k=>{%><option value="<%=k.id_kategori%>" <%=String(f.id_kategori)===String(k.id_kategori)?'selected':''%>><%=k.nama_kategori%></option><%})%></select></div><div class="col-md-2"><label class="form-label small">Status</label><select name="status" class="form-select"><option value="">Semua</option><option <%=f.status==='Tersedia'?'selected':''%>>Tersedia</option><option <%=f.status==='Sedang Proses Klaim'?'selected':''%>>Sedang Proses Klaim</option><option <%=f.status==='Dikembalikan'?'selected':''%>>Dikembalikan</option></select></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-navy w-100">Filter</button></div></form></div></div><div class="card"><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light"><tr><th>ID</th><th>Nama Barang</th><th>Kategori</th><th>Lokasi</th><th>Tanggal</th><th>Pelapor</th><th>Status</th></tr></thead><tbody><%if(items.length){items.forEach(i=>{%><tr><td><%=i.id_barang_temuan%></td><td><%=i.nama_barang%></td><td><%=i.nama_kategori%></td><td><%=i.lokasi_ditemukan%></td><td><%=new Date(i.tanggal_ditemukan).toLocaleDateString('id-ID')%></td><td><%=i.nama_lengkap%></td><td><%=i.status_barang%></td></tr><%})}else{%><tr><td colspan="7" class="text-center text-muted py-4">Tidak ada data</td></tr><%}%></tbody></table></div></div><%- include('../layout/footer') %>