<%- include('../layout/header') %>
<h3 class="fw-bold text-navy mb-4">Log Aktivitas Sistem</h3>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>ID Log</th>
          <th>Pengguna</th>
          <th>Aktivitas</th>
          <th>Tabel Referensi</th>
          <th>ID Ref</th>
          <th>Deskripsi</th>
          <th>Waktu</th>
        </tr>
      </thead>
      <tbody>
        <% if (logs && logs.length > 0) { %>
          <% logs.forEach(l => { %>
            <tr>
              <td><%= l.id_log %></td>
              <td><%= l.nama_lengkap || 'Sistem / Anonim' %></td>
              <td><span class="badge bg-navy"><%= l.aktivitas %></span></td>
              <td><code><%= l.tabel_referensi || '-' %></code></td>
              <td><%= l.id_referensi || '-' %></td>
              <td><%= l.deskripsi || '-' %></td>
              <td><small><%= new Date(l.created_at).toLocaleString('id-ID') %></small></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="7" class="text-center text-muted py-4">Belum ada aktivitas tercatat.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../layout/footer') %>
