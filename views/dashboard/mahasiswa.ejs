<%- include('../layout/header') %>
<div class="hero-banner mb-4">
  <h1 class="h3 fw-bold">Selamat Datang, <%= user.nama_lengkap %>!</h1>
  <p class="mb-0">Sistem Informasi Lost and Found Kampus UIN Maulana Malik Ibrahim Malang</p>
</div>
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card stat-card stat-info h-100 p-3">
      <div class="d-flex justify-content-between align-items-center">
        <div><h6 class="text-muted mb-1">Cari Barang Temuan</h6><h4 class="fw-bold mb-0">Katalog</h4></div>
        <i class="bi bi-collection fs-1 text-primary"></i>
      </div>
      <a href="/katalog" class="btn btn-sm btn-outline-navy mt-3">Lihat Katalog</a>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card stat-danger h-100 p-3">
      <div class="d-flex justify-content-between align-items-center">
        <div><h6 class="text-muted mb-1">Kehilangan Sesuatu?</h6><h4 class="fw-bold mb-0">Lapor Hilang</h4></div>
        <i class="bi bi-question-circle fs-1 text-danger"></i>
      </div>
      <a href="/lapor/hilang" class="btn btn-sm btn-outline-danger mt-3">Buat Laporan</a>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card stat-success h-100 p-3">
      <div class="d-flex justify-content-between align-items-center">
        <div><h6 class="text-muted mb-1">Menemukan Barang?</h6><h4 class="fw-bold mb-0">Lapor Temuan</h4></div>
        <i class="bi bi-box-seam fs-1 text-success"></i>
      </div>
      <a href="/lapor/temuan" class="btn btn-sm btn-outline-success mt-3">Lapor Temuan</a>
    </div>
  </div>
</div>
<div class="card mb-4">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <span class="fw-bold">Barang Temuan Terbaru</span>
    <a href="/katalog" class="btn btn-sm btn-navy">Lihat Semua</a>
  </div>
  <div class="card-body">
    <% if (recentItems && recentItems.length > 0) { %>
      <div class="row row-cols-1 row-cols-md-3 g-3">
        <% recentItems.forEach(item => { %>
          <div class="col">
            <div class="card h-100 card-hover">
              <img src="/uploads/<%= item.foto_barang %>" class="card-img-top catalog-img" alt="<%= item.nama_barang %>" onerror="this.src='https://placehold.co/400x250/1a237e/ffffff?text=Lost+and+Found'">
              <div class="card-body">
                <span class="badge bg-secondary mb-2"><%= item.nama_kategori %></span>
                <h6 class="card-title fw-bold text-navy"><%= item.nama_barang %></h6>
                <p class="card-text small text-muted mb-1"><i class="bi bi-geo-alt"></i> <%= item.lokasi_ditemukan %></p>
                <p class="card-text small text-muted"><i class="bi bi-calendar"></i> <%= new Date(item.tanggal_ditemukan).toLocaleDateString('id-ID') %></p>
                <a href="/katalog/<%= item.id_barang_temuan %>" class="btn btn-sm btn-outline-navy w-100">Detail</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-muted mb-0">Belum ada barang temuan terbaru.</p>
    <% } %>
  </div>
</div>
<%- include('../layout/footer') %>
