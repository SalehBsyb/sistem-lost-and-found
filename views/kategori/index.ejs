<%- include('../layout/header') %><div class="d-flex justify-content-between align-items-center mb-4"><h3 class="fw-bold text-navy">Kelola Kategori Barang</h3><button class="btn btn-navy" data-bs-toggle="modal" data-bs-target="#tambahModal"><i class="bi bi-plus"></i> Tambah Kategori</button></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>ID</th><th>Nama Kategori</th><th>Dibuat</th><th>Aksi</th></tr></thead><tbody><%list.forEach(k=>{%><tr><td><%=k.id_kategori%></td><td><%=k.nama_kategori%></td><td><%=new Date(k.created_at).toLocaleDateString('id-ID')%></td><td><button class="btn btn-sm btn-outline-navy" data-bs-toggle="modal" data-bs-target="#edit<%=k.id_kategori%>">Edit</button> <form action="/kategori/<%=k.id_kategori%>/delete" method="post" class="d-inline" onsubmit="return confirm('Hapus kategori ini?')"><button class="btn btn-sm btn-outline-danger">Hapus</button></form><div class="modal fade" id="edit<%=k.id_kategori%>" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/kategori/<%=k.id_kategori%>/edit"><div class="modal-header"><h5>Edit Kategori</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input name="nama_kategori" class="form-control" value="<%=k.nama_kategori%>" required></div><div class="modal-footer"><button class="btn btn-navy">Simpan</button></div></form></div></div></div></td></tr><%})%></tbody></table></div></div><div class="modal fade" id="tambahModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/kategori"><div class="modal-header"><h5>Tambah Kategori</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input name="nama_kategori" class="form-control" placeholder="Nama kategori" required></div><div class="modal-footer"><button class="btn btn-navy">Tambah</button></div></form></div></div></div><%- include('../layout/footer') %>